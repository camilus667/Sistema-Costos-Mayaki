{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@sistema-uniformes/shared": ["../shared/src"],
      "@sistema-uniformes/shared/*": ["../shared/src/*"],
      "@sistema-uniformes/api": ["../api/src"],
      "@sistema-uniformes/api/*": ["../api/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
